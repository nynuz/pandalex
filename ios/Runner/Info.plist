		<key>NSPhotoLibraryUsageDescription</key>
		<string>Abbiamo bisogno dell'accesso alla galleria per selezionare foto per le segnalazioni</string>
		
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Abbiamo bisogno di salvare le foto per la segnalazione</string>
